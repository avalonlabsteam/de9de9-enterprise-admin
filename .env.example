# ---- Dev server proxy ----
# Base URL the Vite dev server proxies /auth-api and /api to (see vite.config.ts).
# Read by vite.config.ts through loadEnv (import.meta.env does not exist in a
# config file). REQUIRED: there is no hardcoded fallback, so `npm run dev`
# refuses to start without it. A production build does not need it.
VITE_AUTH_ORIGIN=https://api.entreprise.de9de9.dz

# ---- Auth API (real) ----
# Left unset, the app calls the relative path /auth-api, which the Vite dev
# server proxies to https://api.entreprise.de9de9.dz/api/v1 (see vite.config.ts).
#
# Do NOT point this at the absolute URL until the API sends
# Access-Control-Allow-Origin for this app's origin — as of the last check the
# preflight answers 204 with no CORS headers, so the browser blocks the response.
# VITE_AUTH_API_URL=https://api.entreprise.de9de9.dz/api/v1

# ---- Business API ----
# Leave VITE_API_MOCK unset (or anything but "false") for hybrid mode: pages
# still on the mock are served from src/api/mock, while endpoints already
# integrated with the real API (see the passthrough() calls in
# src/api/mock/handlers.ts — currently GET /commandes/worklist) go to the
# network. /api is proxied by the Vite dev server to
# https://api.entreprise.de9de9.dz/api/v1 (same CORS caveat as the auth API).
#
# Set VITE_API_MOCK=false to bypass the mock entirely — every page then hits
# the real API, so pages whose endpoints don't exist yet will fail.
VITE_API_URL=/api
# VITE_API_MOCK=false

# ---- HTTP logging ----
# In dev, every apiClient/authClient request is logged to the browser console
# AND appended as NDJSON to logs/http-<date>.log (written by the dev server's
# /__http-log sink — see vite.config.ts). Endpoint, headers, params/body and
# response are captured; credentials and tokens are masked.
# Set to "false" to silence; "true" force-enables the console logger in a
# production build (the file sink only exists on the dev server).
# VITE_HTTP_LOG=false
